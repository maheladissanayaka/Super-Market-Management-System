<Window x:Class="SuperMarketManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        mc:Ignorable="d"
        Height="645"
        Width="875"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontSize="18"
        FontFamily="{DynamicResource MaterialDesignFont}">


    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="1"
                              Opacity="0.4" />
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.22*" />
        </Grid.ColumnDefinitions>

        <!--Ledft Section-->
        <Border Background="#07bf96"
                CornerRadius="10 0 0 10"
                ClipToBounds="True">

            <Border.Clip>
                <RectangleGeometry Rect="0,0,400,605"
                                   RadiusX="10"
                                   RadiusY="10" />
            </Border.Clip>

            <Grid>
                

                <!--Ellipses Design-->
                <Ellipse Width="500"
                         Height="500"
                         VerticalAlignment="Bottom"
                         Fill="#5eccb4"
                         Margin="50 0 0 -200"
                         Opacity="0.6" />

                <Ellipse Width="300"
                         Height="300"
                         VerticalAlignment="Bottom"
                         Fill="#5bcbb3"
                         Margin="-450 0 0 30"
                         Opacity="0.3" />

                <Ellipse Width="400"
                         Height="400"
                         VerticalAlignment="Bottom"
                         Fill="#5eccb4"
                         Margin="-320 0 0 -120"
                         Opacity="0.3" />

                <Ellipse Width="250"
                         Height="250"
                         VerticalAlignment="Bottom"
                         Fill="#5bc9b2"
                         Margin="-300 0 0 -120" />

                <Ellipse Width="400"
                         Height="400"
                         VerticalAlignment="Bottom"
                         Fill="#5eccb4"
                         Margin="280 0 0 -70"
                         Opacity="0.8" />
                <!--Title and Logo-->
                <StackPanel Margin="0 50 0 0"
                            VerticalAlignment="Top">

                    <TextBlock FontSize="70"
                               FontWeight="Bold"
                               Text="Login"
                               Foreground="#ffffff"
                               TextAlignment="Center" />

                    <Image Source="/Images/logo.png"
                           Width="300"
                           Margin="0 20 0 0" />



                </StackPanel>
                
                <!--Register-->
                <StackPanel Margin="0 450 0 0">
                    <TextBlock FontWeight="Light"
                               FontSize="16"
                               Foreground="AliceBlue"
                               TextAlignment="Center"
                               Text="Dob't have an Account?" />
                    
                    <Button Content="Register"
                            Name="btnRegister"
                            Margin="0 10 0 0"                            
                            Foreground="#ffffff"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            FontSize="18"
                            Width="140"
                            Height="45"
                            materialDesign:ButtonAssist.CornerRadius="22"
                            Click="btnRegister_Click" />
                </StackPanel>                
            </Grid>
        </Border>

        <!--Right Section-->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="0 10 10 0"
                MouseDown="Border_MouseDown">

            <Grid>
                <!--Close Icon-->
                <materialDesign:PackIcon Kind="Close"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Right"
                                         Width="30"
                                         Height="30"
                                         Opacity="0.3"
                                         Margin="0 13 13 0"
                                         MouseDown="PackIcon_MouseDown" />
                <!--Inputs-->
                <StackPanel VerticalAlignment="Center"
                            Margin="75 0">
                    <TextBox x:Name="txtUsername"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text=""
                             materialDesign:HintAssist.Hint="Username"
                             materialDesign:HintAssist.FloatingOffset="0,-20"
                             BorderBrush="#c5c8cc"
                             BorderThickness="0 0 0 1.5" />
                    
                    <Grid>

                        <!-- PasswordBox (hidden by default when revealing) -->
                        <PasswordBox Name="passwordBox"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Visibility="Visible"
                                     materialDesign:HintAssist.Hint="Password"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"
                                     BorderBrush="#c5c8cc"
                                     BorderThickness="0 0 0 1.5" />

                        <!-- TextBox (shows password as plain text) -->
                        <TextBox x:Name="textBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="TextBox_TextChanged"
                                 Visibility="Collapsed"
                                 materialDesign:HintAssist.Hint="Password"
                                 materialDesign:HintAssist.FloatingOffset="0,-20"
                                 BorderBrush="#c5c8cc"
                                 BorderThickness="0 0 0 1.5" />

                        <!-- Button inside the TextBox as a trailing icon -->
                        <Button x:Name="revealBtn"
                                Content="👁"
                                Width="30"
                                FocusVisualStyle="{x:Null}"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="TogglePasswordVisibility_Click"
                                Background="Transparent"
                                BorderBrush="Transparent" />

                    </Grid>


                    <Button Content="Login"
                            Name="btnLogin"
                            FocusVisualStyle="{x:Null}"
                            
                            FontSize="18"
                            Width="120"
                            Height="45"
                            materialDesign:ButtonAssist.CornerRadius="22"
                            Margin="0 30 0 0 "
                            HorizontalAlignment="Center"
                            Click="Button_Click">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Background"
                                        Value="#05b790" />
                                <Setter Property="Foreground"
                                        Value="white" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Foreground"
                                                Value="#05b790" />


                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>

        </Border>

    </Grid>
</Window>
